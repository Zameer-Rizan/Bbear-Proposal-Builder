# Local mode uses data/bbear.sqlite and data/files. Never expose local mode publicly.
# For hosting, set a strong shared staff password and HTTPS.
APP_PASSWORD=
SESSION_SECRET=
# Optional managed PostgreSQL connection (Supabase direct/session pooler supported).
DATABASE_URL=
# Optional absolute folder on a persistent disk for files and local database.
DATA_DIR=

# Keep local until the migration, staff access, and cloud tests are complete.
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
