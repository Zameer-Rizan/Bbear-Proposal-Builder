{
  "name": "bbear-proposal-builder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup:pdf": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/data/browsers\" playwright install chromium",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "1.65.0",
    "zod": "latest",
    "pg": "latest",
    "playwright": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/pg": "latest",
    "tsx": "latest"
  }
}
